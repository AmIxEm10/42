# Secrets réservés au serveur, jamais préfixés VITE_.
# Ne pas coller la clé dans le frontend ou dans un commit.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Jeton interne du relais : généré par npm run setup:env.
MEDIA_ACCESS_TOKEN=
MEDIA_PORT=8787
# Maximum de soumissions par démarrage du relais (échecs compris).
MEDIA_MAX_GENERATIONS=10

# Configuration publique du relais serveur.
VITE_MEDIA_API_BASE_URL=/api/media
